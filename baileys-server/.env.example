# Baileys Server Environment Variables

# Port (Railway auto-assigns, default 3001 for local dev)
PORT=3001

# Shared API key between Next.js frontend and this server
BAILEYS_API_KEY=your-secret-api-key-here

# Supabase (same credentials as your frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Optional: forward incoming WhatsApp messages to the Next.js AI pipeline
WEBHOOK_URL=https://your-nextjs-app.vercel.app/api/ai/whatsapp/webhook
