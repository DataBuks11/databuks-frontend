# ============================================
# DATABUKS - ENVIRONMENT VARIABLES
# ============================================
# Never commit real values. Add these to your
# deployment platform (Vercel) environment settings.

# Supabase (already configured in production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Composio (social connections)
COMPOSIO_API_KEY=
COMPOSIO_INSTAGRAM_AUTH_CONFIG_ID=
COMPOSIO_FACEBOOK_AUTH_CONFIG_ID=
COMPOSIO_LINKEDIN_AUTH_CONFIG_ID=

# WhatsApp Baileys server
BAILEYS_SERVER_URL=
BAILEYS_API_KEY=

# Ox Alpha AI (primary LLM provider - server-side ONLY)
OX_ALPHA_API_KEY=
OX_ALPHA_BASE_URL=
OX_ALPHA_MODEL=ox-alpha

# DeepSeek V4 Flash (fallback LLM - used when OX_ALPHA is not configured)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# AI Sales Agent operational limits (optional, deterministic defaults used when unset)
OUTREACH_DAILY_LIMIT=20
OUTREACH_DUPLICATE_WINDOW_HOURS=24

# Scheduled/internal route authentication
CRON_SECRET=
CRAWLER_SERVICE_KEY=
